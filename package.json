{
  "name": "harness-digest",
  "version": "0.1.0",
  "private": true,
  "description": "A small agent harness that finds instructive agentic-engineering material and sends a weekly digest.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "smoke": "node --env-file=.env --import tsx src/smoke.ts",
    "sweep": "tsx src/sweep.ts",
    "explore": "node --env-file=.env --import tsx src/explore.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
